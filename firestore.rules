rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "ggr20161@gmail.com";
    }

    match /catalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /privateCatalog/{docId} {
      // Private Telegram/PDF access data is never readable directly by customers.
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /purchases/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      // Purchase records are written only by the trusted server/admin.
      allow write: if isAdmin();
    }

    match /purchaseRequests/{reqId} {
      // A signed-in customer can file a payment for admin review, but cannot
      // grant themselves access — only the admin can mark a request paid.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /webhookEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    // Legacy insecure custom-auth documents are intentionally inaccessible.
    match /accounts/{email} {
      allow read, write: if false;
    }
  }
}
